rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function mine() { return signedIn() && resource.data.uid == request.auth.uid; }
    function minePending() { return signedIn() && request.resource.data.uid == request.auth.uid; }

    // 사용자 계정 기록: 본인만 읽기/쓰기/삭제
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    // 실행 기록: 본인이 생성/조회/삭제, 수정 불가
    match /searches/{id} {
      allow create: if minePending();
      allow read, delete: if mine();
      allow update: if false;
    }
    // 후보별 피드백: 본인이 생성/수정/조회/삭제
    match /feedback/{id} {
      allow create: if minePending();
      allow update: if mine() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if mine();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
